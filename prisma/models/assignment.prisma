model OperationAssignment {
  id                String                   @id @default(cuid())
  operationPoolId   String                   @map("operation_pool_id")
  workOrderId       String                   @map("work_order_id")
  partId            String                   @map("part_id")
  workerId          String                   @map("worker_id")
  workerName        String                   @map("worker_name")
  source            String
  status            String                   @default("assigned")
  plannedStart      DateTime                 @map("planned_start")
  plannedEnd        DateTime                 @map("planned_end")
  plannedQuantity   Int                      @map("planned_quantity")
  estimatedHours    Float?                   @map("estimated_hours")
  canWorkerRemove   Boolean                  @default(false) @map("can_worker_remove")
  claimedAt         DateTime?                @map("claimed_at")
  assignedById      String?                  @map("assigned_by_id")
  assignedByName    String?                  @map("assigned_by_name")
  assignedByRole    String?                  @map("assigned_by_role")
  cancelledReason   String?                  @map("cancelled_reason")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  operationPool     OperationPool            @relation(fields: [operationPoolId], references: [id])
  workOrder         WorkOrder                @relation(fields: [workOrderId], references: [id])
  part              WorkOrderPart            @relation(fields: [partId], references: [id])
  worker            User                     @relation("WorkerAssignments", fields: [workerId], references: [id])
  assignedBy        User?                    @relation("AssignedBy", fields: [assignedById], references: [id])
  collaborators     AssignmentCollaborator[]
  session           WorkSession?

  @@index([workerId, status])
  @@index([workerId, plannedStart])
  @@index([operationPoolId])
  @@map("operation_assignments")
  @@schema("work_report")
}

model AssignmentCollaborator {
  id           String              @id @default(cuid())
  assignmentId String              @map("assignment_id")
  userId       String?             @map("user_id")
  name         String
  assignment   OperationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_collaborators")
  @@schema("work_report")
}

model WorkSession {
  id                   String              @id @default(cuid())
  assignmentId         String              @unique @map("assignment_id")
  operatorId           String              @map("operator_id")
  operatorName         String              @map("operator_name")
  status               String
  startedAt            DateTime?           @map("started_at")
  completedAt          DateTime?           @map("completed_at")
  accumulatedSeconds   Int                 @default(0) @map("accumulated_seconds")
  currentRunStartedAt  DateTime?           @map("current_run_started_at")
  completedQuantity    Int?                @map("completed_quantity")
  note                 String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  assignment           OperationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("work_sessions")
  @@schema("work_report")
}
