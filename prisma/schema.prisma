generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["work_report"]
}

model ExpressRequestLog {
  id           String   @id @default(cuid())
  method       String
  path         String
  originalUrl  String   @map("original_url")
  statusCode   Int      @map("status_code")
  durationMs   Int      @map("duration_ms")
  ip           String?
  userAgent    String?  @map("user_agent")
  userId       String?  @map("user_id")
  requestBody  Json?    @map("request_body")
  responseBody Json?    @map("response_body")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([method, path])
  @@index([statusCode])
  @@index([userId])
  @@map("express_request_logs")
  @@schema("work_report")
}

model AxiosRequestLog {
  id           String   @id @default(cuid())
  method       String
  url          String
  baseUrl      String?  @map("base_url")
  statusCode   Int?     @map("status_code")
  durationMs   Int      @map("duration_ms")
  requestBody  Json?    @map("request_body")
  responseBody Json?    @map("response_body")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([method, url])
  @@index([statusCode])
  @@map("axios_request_logs")
  @@schema("work_report")
}

model XftIntegrationConfig {
  id                    String   @id @default("default")
  host                  String
  appid                 String
  appSecret             String   @map("app_secret")
  enterpriseId          String   @map("enterprise_id")
  defaultUserId         String   @default("U0000") @map("default_user_id")
  defaultPlatformUserId String   @default("AUTO0001") @map("default_platform_user_id")
  dataCollectionName    String   @map("data_collection_name")
  importType            String   @default("ADD") @map("import_type")
  salaryPeriod          String   @map("salary_period")
  workHoursFieldKey     String   @map("work_hours_field_key")
  isCheckEmpty          Boolean  @default(false) @map("is_check_empty")
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("xft_integration_configs")
  @@schema("work_report")
}

model User {
  id                String               @id @default(cuid())
  wecomUserId       String?              @map("wecom_user_id")
  employeeNo        String?              @map("employee_no")
  username          String?              @unique
  passwordHash      String?              @map("password_hash")
  name              String
  nameInitials      String?              @map("name_initials")
  avatar            String?
  gender            String?
  qrCode            String?              @map("qr_code")
  mobile            String?
  email             String?
  bizMail           String?              @map("biz_mail")
  address           String?
  department        Json?
  departmentOrder   Json?                @map("department_order")
  position          String?
  isLeaderInDept    Json?                @map("is_leader_in_dept")
  directLeader      Json?                @map("direct_leader")
  telephone         String?
  alias             String?
  extattr           Json?
  wecomStatus       Int?                 @map("wecom_status")
  externalProfile   Json?                @map("external_profile")
  externalPosition  String?              @map("external_position")
  openUserid        String?              @map("open_userid")
  mainDepartment    Int?                 @map("main_department")
  teamName          String?              @map("team_name")
  status            String               @default("active")
  lastLoginAt       DateTime?            @map("last_login_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  assignments       OperationAssignment[] @relation("WorkerAssignments")
  assignedItems     OperationAssignment[] @relation("AssignedBy")
  userRoles         UserRole[]

  @@map("users")
  @@schema("work_report")
}

model WecomDepartment {
  id           String                @id @default(cuid())
  clientId     String                @map("client_id")
  departmentId Int                   @map("department_id")
  name         String?
  nameEn       String?               @map("name_en")
  parentId     Int                   @map("parent_id")
  order        BigInt?               @map("order_value")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  users        WecomUserDepartment[]

  @@unique([clientId, departmentId])
  @@index([clientId, parentId])
  @@map("wecom_departments")
  @@schema("work_report")
}

model WecomUserDepartment {
  clientId     String           @map("client_id")
  userId       String           @map("user_id")
  departmentId Int              @map("department_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  department   WecomDepartment? @relation(fields: [clientId, departmentId], references: [clientId, departmentId], onDelete: Cascade)

  @@id([clientId, userId, departmentId])
  @@index([clientId, departmentId])
  @@index([userId])
  @@map("wecom_user_departments")
  @@schema("work_report")
}

model UserRole {
  userId String
  roleId String
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("work_report")
}

model Role {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  userRoles  UserRole[]

  @@map("roles")
  @@schema("work_report")
}

model OperationAssignment {
  id                String                  @id @default(cuid())
  operationPoolId   String                  @map("operation_pool_id")
  workOrderId       String                  @map("work_order_id")
  partId            String                  @map("part_id")
  workerId          String                  @map("worker_id")
  workerName        String                  @map("worker_name")
  source            String
  status            String                  @default("assigned")
  plannedStart      DateTime                @map("planned_start")
  plannedEnd        DateTime                @map("planned_end")
  plannedQuantity   Int                     @map("planned_quantity")
  estimatedHours    Float?                  @map("estimated_hours")
  actualStartAt     DateTime?               @map("actual_start_at")
  actualEndAt       DateTime?               @map("actual_end_at")
  canWorkerRemove   Boolean                 @default(false) @map("can_worker_remove")
  claimedAt         DateTime?               @map("claimed_at")
  assignedById      String?                 @map("assigned_by_id")
  assignedByName    String?                 @map("assigned_by_name")
  assignedByRole    String?                 @map("assigned_by_role")
  cancelledReason   String?                 @map("cancelled_reason")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  operationPool     OperationPool           @relation(fields: [operationPoolId], references: [id])
  workOrder         WorkOrder               @relation(fields: [workOrderId], references: [id])
  part              WorkOrderPart           @relation(fields: [partId], references: [id])
  worker            User                    @relation("WorkerAssignments", fields: [workerId], references: [id])
  assignedBy        User?                   @relation("AssignedBy", fields: [assignedById], references: [id])
  collaborators     AssignmentCollaborator[]
  session           WorkSession?

  @@index([workerId, status])
  @@index([workerId, plannedStart])
  @@index([operationPoolId])
  @@map("operation_assignments")
  @@schema("work_report")
}

model AssignmentCollaborator {
  id           String               @id @default(cuid())
  assignmentId String               @map("assignment_id")
  userId       String?              @map("user_id")
  name         String
  assignment   OperationAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_collaborators")
  @@schema("work_report")
}

model WorkSession {
  id                   String               @id @default(cuid())
  assignmentId         String               @unique @map("assignment_id")
  operatorId           String               @map("operator_id")
  operatorName         String               @map("operator_name")
  status               String
  startedAt            DateTime?            @map("started_at")
  completedAt          DateTime?            @map("completed_at")
  accumulatedSeconds   Int                  @default(0) @map("accumulated_seconds")
  currentRunStartedAt  DateTime?            @map("current_run_started_at")
  completedQuantity    Int?                 @map("completed_quantity")
  note                 String?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  assignment           OperationAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("work_sessions")
  @@schema("work_report")
}

model AttendanceRecord {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  date             DateTime @db.Date
  shiftName        String   @map("shift_name")
  regularHours     Float    @map("regular_hours")
  overtimeHours    Float    @map("overtime_hours")
  attendanceStatus String   @map("attendance_status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("attendance_records")
  @@schema("work_report")
}

model WorkOrder {
  id                String           @id @default(cuid())
  orderNo           String           @unique @map("order_no")
  productCode       String           @map("product_code")
  productName       String           @map("product_name")
  plannedQuantity   Int              @map("planned_quantity")
  completedQuantity Int              @default(0) @map("completed_quantity")
  dueDate           DateTime         @map("due_date") @db.Date
  status            String           @default("pending")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  parts             WorkOrderPart[]
  operationPools    OperationPool[]
  assignments       OperationAssignment[]

  @@index([orderNo])
  @@index([productCode])
  @@index([status])
  @@map("work_orders")
  @@schema("work_report")
}

model WorkOrderPart {
  id                String           @id @default(cuid())
  workOrderId       String           @map("work_order_id")
  partNo            String?          @map("part_no")
  partCode          String           @map("part_code")
  partName          String           @map("part_name")
  plannedQuantity   Int              @map("planned_quantity")
  completedQuantity Int              @default(0) @map("completed_quantity")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  workOrder         WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  operationPools    OperationPool[]
  assignments       OperationAssignment[]

  @@unique([workOrderId, partCode])
  @@map("work_order_parts")
  @@schema("work_report")
}

model OperationPool {
  id                String           @id @default(cuid())
  workOrderId       String           @map("work_order_id")
  partId            String           @map("part_id")
  operationNo       String?          @map("operation_no")
  operationCode     String           @map("operation_code")
  operationName     String           @map("operation_name")
  operationNote     String           @default("") @map("operation_note")
  plannedQuantity   Int              @map("planned_quantity")
  plannedStart      DateTime?        @map("planned_start")
  remainingQuantity Int              @map("remaining_quantity")
  estimatedHours    Float            @map("estimated_hours")
  claimedWorkers    Int              @default(0) @map("claimed_workers")
  maxClaimWorkers   Int?             @map("max_claim_workers")
  status            String           @default("available")
  source            String           @default("system")
  createdBy         String?          @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  workOrder         WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part              WorkOrderPart    @relation(fields: [partId], references: [id], onDelete: Cascade)
  assignments       OperationAssignment[]

  @@unique([workOrderId, partId, operationCode])
  @@index([status])
  @@index([plannedStart])
  @@map("operation_pool")
  @@schema("work_report")
}
