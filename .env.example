DATABASE_URL="postgresql://user:password@localhost:5432/work_report"
AUTH_API_BASE_URL="http://localhost:2000/"
PORT=8080
CORS_ORIGIN="http://localhost:5173"
CORS_CREDENTIALS=true
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
AUTH_CACHE_TTL_SECONDS=300
JWT_SECRET=
AUTH_TOKEN_TTL=30m
AUTH_CLIENT_IDS=legacy-frontend,new-frontend
WECHAT_AUTH_ALLOWED_ORIGINS=http://localhost:5173
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECHAT_PROXY_HOST=http://122.226.146.110:780
WECHAT_PROXY_CRYPTO_SECRET=
# 可选：也可以使用根目录 wechat.json 配置多个企业微信认证客户端。
# WECHAT_AUTH_CLIENTS=[{"corpId":"wwxxx","name":"jctimes","apps":[{"agentId":1000044,"corpSecret":"xxx","name":"CRM","clientId":"legacy-frontend","allowedOrigins":["http://localhost:5173"],"scopes":[]}]}]
# 兼容简单环境变量配置：
WECOM_LEGACY_CORP_ID=
WECOM_LEGACY_AGENT_ID=
WECOM_LEGACY_CORP_SECRET=
WECOM_NEW_CORP_ID=
WECOM_NEW_AGENT_ID=
WECOM_NEW_CORP_SECRET=
ALLOW_MOCK_TOKEN=false
MOCK_AUTH_TOKEN=mock-token
MOCK_USER_ID=demo-worker
MOCK_USER_NAME=张师傅
MOCK_USER_ROLES=worker
IMPORT_API_KEY=
IMPORT_API_SECRET=
IMPORT_SIGNATURE_TTL_SECONDS=300

# 薪福通默认配置，可在前端管理页保存覆盖
XFT_HOST="https://api.cmbchina.com"
XFT_APPID=
XFT_AUTHORITY_SECRET=
XFT_ENTERPRISE_ID=

# 薪福通单点登录（/xft/sso）
# XFT_SSO_PRIVATE_KEY：薪福通 SSO 私钥，支持完整 PEM 或把换行写成 \n。
XFT_SSO_PRIVATE_KEY=
# XFT_SSO_CONNECTOR_ID / XFT_SSO_FLOW_ID：薪福通登录网关地址里的连接器 ID 和连接流 ID。
# 最终跳转地址形如：${XFT_SSO_LOGIN_BASE_URL}/${XFT_SSO_CONNECTOR_ID}_${XFT_SSO_FLOW_ID}
XFT_SSO_CONNECTOR_ID=223147993689554944
XFT_SSO_FLOW_ID=224943279282388992
# XFT_SSO_WECOM_CLIENT_ID：没有前端 token、走企业微信 code 兜底登录时使用的企业微信认证客户端。
XFT_SSO_WECOM_CLIENT_ID=legacy-frontend
# XFT_SSO_LOGIN_BASE_URL：薪福通 SSO 登录网关基础地址，通常不需要修改。
XFT_SSO_LOGIN_BASE_URL=https://xft.cmbchina.com/xft-gateway/xft-login-new/xwapi/login
